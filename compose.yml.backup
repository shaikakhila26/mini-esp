services:
  postgres:
    image: postgres:17
    restart: unless-stopped

    environment:
      POSTGRES_DB: mini_esp
      POSTGRES_USER: esp_app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}

    ports:
      - "127.0.0.1:5432:5432"

    volumes:
      - postgres_data:/var/lib/postgresql/data

    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U esp_app -d mini_esp
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  postgres_data: